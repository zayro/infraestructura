{
  "info": {
    "_postman_id": "demo-etapa1-infraestructura",
    "name": "Demo Etapa 1 - Infraestructura Microservicios",
    "description": "Colección para probar el stack Traefik → test-fastapi-service y test-fastify-service (items, eventos CRUD). Todo el tráfico entra por Traefik ({{base_url}}). Los microservicios no publican puertos al host.\n\nAntes de empezar: levanta el stack con `docker compose up -d --build` y verifica con `docker compose ps` que traefik y los servicios estén healthy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
