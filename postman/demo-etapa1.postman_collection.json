  "item": [
    {
      "name": "Autenticación y RBAC (Traefik Dynamic JWT)",
      "item": [
        {
          "name": "Sin token → 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized sin token', () => pm.response.to.have.status(401));"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/node", "host": ["{{base_url}}"], "path": ["api", "node"] } }
        },
        {
          "name": "Token inválido o firma incorrecta → 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized token inválido', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "invalid.jwt.token", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/node", "host": ["{{base_url}}"], "path": ["api", "node"] }
          }
        },
        {
          "name": "Token servicio válido → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK con token de servicio', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/node?delay_ms=50&fail=0", "host": ["{{base_url}}"], "path": ["api", "node"], "query": [{ "key": "delay_ms", "value": "50" }, { "key": "fail", "value": "0" }] }
          }
        },
        {
          "name": "Token admin válido → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK con token de admin', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/node?delay_ms=50&fail=0", "host": ["{{base_url}}"], "path": ["api", "node"], "query": [{ "key": "delay_ms", "value": "50" }, { "key": "fail", "value": "0" }] }
          }
        },
        {
          "name": "Token user válido → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK con token de user', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/test?delay_ms=50&fail=0", "host": ["{{base_url}}"], "path": ["api", "test"], "query": [{ "key": "delay_ms", "value": "50" }, { "key": "fail", "value": "0" }] }
          }
        }
      ]
    },
    {
      "name": "Demo - Traefik → Fastify",
      "item": [
        {
          "name": "Demo - flujo OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(body.ok).to.eql(true));",
                  "pm.collectionVariables.set('trace_id', body.trace_id);",
                  "console.log('trace_id:', body.trace_id, '→ búscalo en Grafana/Tempo');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/node?delay_ms=150&fail=0",
              "host": ["{{base_url}}"],
              "path": ["api", "node"],
              "query": [
                { "key": "delay_ms", "value": "150", "description": "Latencia simulada (0-2000 ms)" },
                { "key": "fail", "value": "0", "description": "1 = fuerza error 500 en test-fastify-service" }
              ]
            },
            "description": "Equivalente a `make test-ok`. Flujo Traefik → test-fastify-service. Debe responder 200 con un trace_id (se guarda en la variable de colección `trace_id`)."
          },
          "response": []
        },
        {
          "name": "Demo - error controlado (502)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 500 (error simulado)', () => pm.response.to.have.status(500));",
                  "const body = pm.response.json();",
                  "pm.test('ok=false', () => pm.expect(body.ok).to.eql(false));",
                  "pm.collectionVariables.set('trace_id', body.trace_id);",
                  "console.log('trace_id:', body.trace_id, '→ verifica la traza de error en Tempo');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/node?delay_ms=100&fail=1",
              "host": ["{{base_url}}"],
              "path": ["api", "node"],
              "query": [
                { "key": "delay_ms", "value": "100" },
                { "key": "fail", "value": "1" }
              ]
            },
            "description": "Equivalente a `make test-fail`. test-fastify-service devuelve 500. Útil para validar trazas y logs de error."
          },
          "response": []
        },
        {
          "name": "Demo - latencia alta (1200ms)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/node?delay_ms=1200&fail=0",
              "host": ["{{base_url}}"],
              "path": ["api", "node"],
              "query": [
                { "key": "delay_ms", "value": "1200" },
                { "key": "fail", "value": "0" }
              ]
            },
            "description": "Incrementa la latencia observada sin tocar infraestructura. Comprueba el histograma demo_http_request_duration_seconds en Prometheus y la duración del span en Tempo."
          },
          "response": []
        }
      ]
    },
    {
      "name": "FastAPI - test-fastapi-service",
      "item": [
        {
          "name": "Ping",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/test", "host": ["{{base_url}}"], "path": ["api", "test"] }, "description": "Ping del servicio FastAPI vía Traefik." },
          "response": []
        },
        {
          "name": "Items - crear",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\": \"postman-item\"}" },
            "url": { "raw": "{{base_url}}/api/test/items", "host": ["{{base_url}}"], "path": ["api", "test", "items"] }
          },
          "response": []
        },
        {
          "name": "Items - listar (Redis cache)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/test/items", "host": ["{{base_url}}"], "path": ["api", "test", "items"] } },
          "response": []
        },
        {
          "name": "Events - crear (202, publica en RabbitMQ)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 202', () => pm.response.to.have.status(202));", "pm.collectionVariables.set('fastapi_event_id', pm.response.json().event_id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\": \"postman-event\"}" },
            "url": { "raw": "{{base_url}}/api/test/events", "host": ["{{base_url}}"], "path": ["api", "test", "events"] },
            "description": "Guarda el evento en test_events y lo publica en RabbitMQ (lo consume test-fastify). Guarda event_id en `fastapi_event_id`."
          },
          "response": []
        },
        {
          "name": "Events - listar",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/test/events", "host": ["{{base_url}}"], "path": ["api", "test", "events"] } },
          "response": []
        },
        {
          "name": "Events - obtener por id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/test/events/{{fastapi_event_id}}", "host": ["{{base_url}}"], "path": ["api", "test", "events", "{{fastapi_event_id}}"] } },
          "response": []
        },
        {
          "name": "Events - actualizar",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\": \"postman-event-updated\"}" },
            "url": { "raw": "{{base_url}}/api/test/events/{{fastapi_event_id}}", "host": ["{{base_url}}"], "path": ["api", "test", "events", "{{fastapi_event_id}}"] }
          },
          "response": []
        },
        {
          "name": "Events - eliminar (204)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 204', () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{base_url}}/api/test/events/{{fastapi_event_id}}", "host": ["{{base_url}}"], "path": ["api", "test", "events", "{{fastapi_event_id}}"] } },
          "response": []
        }
      ]
    },
