  "item": [
    {
      "name": "1. Autenticación y RBAC (Traefik Dynamic JWT)",
      "item": [
        {
          "name": "Ruta pública FastAPI (/api/test/public) → 200 sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK (sin token)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(body.ok).to.eql(true));",
                  "pm.test('Mensaje publico', () => pm.expect(body.message).to.include('publico'));",
                  "pm.test('Sin usuario en auth', () => pm.expect(body.auth.user).to.be.null);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/test/public", "host": ["{{base_url}}"], "path": ["api", "test", "public"] },
            "description": "Demuestra acceso público sin token JWT a través del router app-test-fastapi-public de Traefik."
          }
        },
        {
          "name": "Ruta pública Fastify (/api/node/public) → 200 sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK (sin token)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(body.ok).to.eql(true));",
                  "pm.test('Mensaje publico', () => pm.expect(body.message).to.include('publico'));",
                  "pm.test('Sin usuario en auth', () => pm.expect(body.auth.user).to.be.null);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/node/public", "host": ["{{base_url}}"], "path": ["api", "node", "public"] },
            "description": "Demuestra acceso público sin token JWT a través del router app-test-fastify-public de Traefik."
          }
        },
        {
          "name": "Ruta protegida FastAPI (/api/test) sin token → 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized sin token', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/test", "host": ["{{base_url}}"], "path": ["api", "test"] },
            "description": "Verifica que la ruta protegida /api/test exija JWT y rechace llamadas sin token."
          }
        },
        {
          "name": "Ruta protegida Fastify (/api/node) sin token → 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized sin token', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/node", "host": ["{{base_url}}"], "path": ["api", "node"] },
            "description": "Verifica que la ruta protegida /api/node exija JWT y rechace llamadas sin token."
          }
        },
        {
          "name": "Token inválido o corrupto → 401 Unauthorized",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized token inválido', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "token.invalido.123", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/node", "host": ["{{base_url}}"], "path": ["api", "node"] },
            "description": "Verifica que Traefik rechace tokens con firma criptográfica incorrecta."
          }
        },
        {
          "name": "Token servicio válido → 200 (captura identidad)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Retorna contexto auth', () => pm.expect(body.auth).to.be.an('object'));",
                  "pm.test('Usuario es app-service', () => pm.expect(body.auth.user).to.eql('app-service'));",
                  "pm.test('Email es app-service@app.local', () => pm.expect(body.auth.email).to.eql('app-service@app.local'));",
                  "pm.test('Contiene rol service', () => pm.expect(body.auth.roles).to.include('service'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/node?delay_ms=0&fail=0", "host": ["{{base_url}}"], "path": ["api", "node"], "query": [{ "key": "delay_ms", "value": "0" }, { "key": "fail", "value": "0" }] },
            "description": "Prueba autenticación con cuenta de servicio y verifica que Fastify reciba user, email y roles."
          }
        },
        {
          "name": "Token admin válido → 200 (captura admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Usuario es app-admin', () => pm.expect(body.auth.user).to.eql('app-admin'));",
                  "pm.test('Email es app-admin@app.local', () => pm.expect(body.auth.email).to.eql('app-admin@app.local'));",
                  "pm.test('Contiene rol admin', () => pm.expect(body.auth.roles).to.include('admin'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/node?delay_ms=0&fail=0", "host": ["{{base_url}}"], "path": ["api", "node"], "query": [{ "key": "delay_ms", "value": "0" }, { "key": "fail", "value": "0" }] },
            "description": "Prueba autenticación con token de administrador."
          }
        },
        {
          "name": "Token user válido → 200 (FastAPI captura user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Usuario es app-user', () => pm.expect(body.auth.user).to.eql('app-user'));",
                  "pm.test('Email es app-user@app.local', () => pm.expect(body.auth.email).to.eql('app-user@app.local'));",
                  "pm.test('Contiene rol user', () => pm.expect(body.auth.roles).to.include('user'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/test?delay_ms=0&fail=0", "host": ["{{base_url}}"], "path": ["api", "test"], "query": [{ "key": "delay_ms", "value": "0" }, { "key": "fail", "value": "0" }] },
            "description": "Prueba autenticación con usuario estándar contra el servicio FastAPI."
          }
        }
      ]
