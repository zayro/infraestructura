GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

RATE_LIMIT_AVERAGE=10
RATE_LIMIT_BURST=20
MAX_INFLIGHT_REQUESTS=50

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# Autenticacion JWT (Traefik dynamic-jwt-validation-middleware)
# Clave HMAC secreta compartida para validar tokens en el Gateway (minimo 32 caracteres)
JWT_SECRET=super-secret-jwt-token-key-32-chars-long
JWT_ISSUER=app-traefik

# Muestreo de trazas de Traefik (1.0 = todas las solicitudes)
TRAEFIK_TRACING_SAMPLE_RATE=1.0
