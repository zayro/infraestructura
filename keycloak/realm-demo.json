{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "user", "description": "Acceso de lectura y escritura a las APIs" },
      { "name": "admin", "description": "Administrador de las APIs" },
      { "name": "service", "description": "Cuenta de servicio (comunicacion entre servicios)" }
    ]
  },
  "clients": [
    {
      "clientId": "demo-api",
      "name": "APIs del demo (audiencia validada por el gateway)",
      "enabled": true,
      "publicClient": false,
      "secret": "${DEMO_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "bearerOnly": false
    },
    {
      "clientId": "demo-client",
      "name": "Cliente de usuarios (Postman, curl, frontends)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:*", "https://oauth.pstmn.io/*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "audience-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "demo-service",
      "name": "Cuenta de servicio para llamadas entre servicios (client_credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "${DEMO_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "email": "demo-user@demo.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "demo-admin",
      "enabled": true,
      "email": "demo-admin@demo.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["user", "admin"]
    },
    {
      "username": "service-account-demo-service",
      "enabled": true,
      "serviceAccountClientId": "demo-service",
      "realmRoles": ["service"]
    }
  ]
}
